# Postdrop — copy to .env and fill. Never commit real values.

# Public origin for Link URLs
BASE_URL=http://localhost:3000

# auth: password (v1) | firebase (reserved)
AUTH_MODE=password
OWNER_EMAIL=
OWNER_PASSWORD=
SESSION_SECRET=

# storage: disk | s3
STORAGE_DRIVER=disk
DISK_STORAGE_PATH=./.storage

# s3 driver (R2 or B2 S3 endpoint, forcePathStyle)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# mongo
MONGODB_URI=

# email (Resend)
RESEND_API_KEY=
RESEND_FROM=

# sweeper: set to 1 in test env
SWEEPER_DISABLED=
