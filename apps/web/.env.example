# MongoDB connection string
MONGODB_URI=

# Public origin — share links are built as ${BASE_URL}/a/<linkToken>
BASE_URL=http://localhost:3000

# Auth.js secret (openssl rand -base64 32) and trust-host for self-hosting
AUTH_SECRET=
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend). Unset: signup auto-verifies and verification/reset email is unavailable.
RESEND_API_KEY=
RESEND_FROM=

# Storage: "disk" (dev/tests) or "s3" (Backblaze B2 and any S3-compatible endpoint).
# presigned direct uploads (>4.5MB) require STORAGE_DRIVER=s3 — see docs/adr/0011.
STORAGE_DRIVER=disk
DISK_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Limits: max artifact size (default 5242880 = 5MB) and per-user storage quota (default 524288000 = 500MB)
MAX_ARTIFACT_BYTES=5242880
QUOTA_BYTES=524288000

# Set to 1 to disable the background sweeper (share-link expiry marking + paste purge)
SWEEPER_DISABLED=
